# =============================================================================
# Sales CRM - environment
# =============================================================================
# Copy to `.env` for local work. On Hostinger, set every one of these in the
# Node.js app's Environment Variables panel. Nothing in this codebase reads a
# hardcoded URL, key or secret; if a value is missing the app fails at boot
# with a named error instead of starting half-configured.
#
# Required variables are marked REQUIRED. The rest have safe defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Hostinger injects PORT itself. `npm start` binds to it; 3000 is the fallback.
PORT=3000

NODE_ENV=development

# REQUIRED. Public origin, no trailing slash. Used to build the Meta webhook
# callback URL shown in the setup screen, and to mark cookies secure.
# e.g. https://crm.yourdomain.com
APP_URL=http://localhost:3000

# IANA timezone that the Overview month picker and all date grouping use.
APP_TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# Database - Neon PostgreSQL
# -----------------------------------------------------------------------------
# Two URLs, both from the Neon dashboard.
#
#   DATABASE_URL        pooled   (host contains "-pooler") - used by the app
#   DIRECT_DATABASE_URL unpooled (no "-pooler")            - used by migrations
#
# Neon requires TLS. `sslmode=require` works today, but the pg driver warns
# that a future major version will weaken what `require` means. Writing
# `sslmode=verify-full` instead keeps the current, stronger behaviour and
# silences the warning. Neon supports it.

# REQUIRED
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# REQUIRED
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Connection pool sizing for the pg driver adapter.
#
# Size this for concurrency, not for the size of the database. The Overview
# costs about seventeen round-trips, so ten people opening it at once is a
# hundred and seventy queries: at a pool of 10 that is seventeen waves of
# network latency, at 25 it is seven. Neon's pooler handles thousands of
# client connections, so 25 from one Node process costs nothing there.
DATABASE_POOL_MAX=25
DATABASE_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# REQUIRED. At least 32 characters. Peppers password hashes and session tokens.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every existing password and session. Do not rotate
# casually.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session cookie name and lifetime.
# Tenant guard: an audit tool, off unless you turn it on.
#
# "warn" lists every query on tenant data that reaches a SET of rows without
# naming an organisation; "strict" throws on the first one. Most of what it
# reports is safe - a payment aggregate filtered by an already-checked orderId
# looks identical to a genuinely unscoped one - so this is for reading through
# deliberately after the query surface changes, not for leaving on.
TENANT_GUARD=

SESSION_COOKIE_NAME=crm_session
SESSION_TTL_HOURS=168

# Login throttling: max failed attempts per email+IP inside the window.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Owner seed  (`npm run seed`)
# -----------------------------------------------------------------------------
# The very first account. Nobody can sign themselves up, so this is the only
# way an account exists before the owner starts creating admins.
# Run the seed once, log in, change the password, then clear these values.

# The first workspace. Every row in the database belongs to an organisation,
# so the seed creates one alongside the owner. The slug appears in sign-in
# URLs and can never be changed casually - pick it deliberately.
SEED_ORG_NAME="My Company"
SEED_ORG_SLUG=main

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD="change-this-before-you-run-the-seed"
SEED_OWNER_NAME="Owner"

# -----------------------------------------------------------------------------
# Cron  (IndiaMART polling)
# -----------------------------------------------------------------------------
# The app has no worker process. An external scheduler hits
# POST /api/cron/indiamart every 5 minutes, carrying this secret as
#   Authorization: Bearer <CRON_SECRET>
# The route also enforces the interval server-side against the SyncState table,
# so an over-eager scheduler still cannot call IndiaMART early.
#
# REQUIRED if IndiaMART is enabled.
CRON_SECRET="change-me-to-another-long-random-string"

# -----------------------------------------------------------------------------
# IndiaMART Lead Manager CRM API v2
# -----------------------------------------------------------------------------
# Leave INDIAMART_CRM_KEY empty to switch the integration off entirely.
# Key: IndiaMART seller panel -> Lead Manager -> Import/Export Leads -> CRM API.

# Which workspace the IndiaMART and Meta credentials below belong to.
#
# Those are still process-wide, which means they can only ever serve ONE
# organisation - one CRM key fetches one seller's enquiries. Naming that
# workspace is the honest way to say so; the alternative would be feeding one
# seller's leads into everybody's. Leave empty and both integrations are off.
INTEGRATIONS_ORG_SLUG=main

INDIAMART_CRM_KEY=
INDIAMART_API_URL="https://mapi.indiamart.com/wservce/crm/crmListing/v2/"

# IndiaMART rejects more than one call per 5 minutes per key. Never lower this.
INDIAMART_MIN_INTERVAL_MINUTES=5

# How far back each poll asks for, in minutes. Comfortably wider than the
# interval so a missed cron tick does not lose leads; dedupe absorbs the overlap.
INDIAMART_LOOKBACK_MINUTES=30

# Abort a hung request rather than holding the sync lock.
INDIAMART_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Meta (Facebook) Lead Ads
# -----------------------------------------------------------------------------
# Leave META_APP_SECRET empty to switch the integration off entirely.
#
# Webhook callback URL to register in the Meta app:
#   <APP_URL>/api/webhooks/meta
# Subscribe the page to the `leadgen` field.

# App secret, from Meta App Dashboard -> Settings -> Basic. Verifies the
# X-Hub-Signature-256 header on every incoming webhook POST.
META_APP_SECRET=

# Any string you choose. Must match the "Verify Token" typed into Meta when
# registering the webhook; answers the GET handshake.
META_VERIFY_TOKEN=

# Page access token with leads_retrieval. Used to fetch the lead field values
# once a leadgen notification arrives.
META_PAGE_ACCESS_TOKEN=

META_GRAPH_VERSION=v21.0
META_GRAPH_URL="https://graph.facebook.com"
META_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Dodo Payments - subscription billing
# -----------------------------------------------------------------------------
# Leave DODO_PAYMENTS_API_KEY empty to switch subscription billing off
# entirely: the "Renew" button on the Your company page simply does not
# appear, and the platform administrator's manual subscription date at /admin
# (unchanged) stays the only way a workspace's access is extended. One flat
# plan - there are no tiers, and the price is set on the product below, not
# here, so it cannot drift from what a customer is actually charged.
#
# Dodo Payments dashboard -> Developer -> API Keys. Use test mode
# (test.dodopayments.com) until you are ready to take real payments.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test

# Dodo Payments dashboard -> Products -> create the subscription product once,
# priced however you want, and paste its product id here.
DODO_PAYMENTS_PRODUCT_ID=

# Dodo Payments dashboard -> Developer -> Webhooks -> add
#   <APP_URL>/api/webhooks/dodo-payments
# Dodo Payments shows you a signing secret (whsec_...) when you save it; paste
# it here. Verifies the webhook-signature header (the Standard Webhooks
# format) on every incoming webhook POST, the same way META_APP_SECRET
# verifies Meta's.
DODO_PAYMENTS_WEBHOOK_SECRET=

# Quotation numbering (REF-020, REF-021, ...) and the letterhead - company
# name, address, GSTIN, logo and bank details - are no longer here. Both
# belong to an organisation, not to the process: the letterhead is filled in
# from Settings, and Organisation.quotationNumberStart (defaults to 1) is
# where an organisation continuing a legacy REF- series would be set.
