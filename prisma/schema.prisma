// Sales CRM - PostgreSQL (Neon) reached through the @prisma/adapter-pg driver adapter.
//
// engineType = "client" + the pg driver adapter means the generated client is
// pure JS/Wasm: there is NO native Rust query-engine binary to ship or to match
// to a platform. That is what makes this deployable to a plain Node 22 app slot.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "esm"
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  SALESMAN
  CRE
}

enum LeadSource {
  INDIAMART
  META
  MANUAL
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  ORDER_CONFIRMED
  LOST
}

/// Where an order sits in the pipeline. Preserved verbatim when a user is
/// deleted and their work is transferred to somebody else.
enum OrderStage {
  CONFIRMED
  WITH_CRE
  CLOSED
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// A quotation moves DRAFT -> SENT -> ACCEPTED, and an accepted quotation is
/// what an order is placed from. REJECTED and EXPIRED are terminal.
enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ActivityKind {
  NOTE
  STATUS_CHANGE
  GRAB
  TRANSFER
  ORDER_CONFIRMED
  HANDOVER
  PAYMENT
  CLOSED
}

// ---------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------

/// One customer company using this CRM.
///
/// Every row that belongs to somebody carries an orgId back to here. That is
/// denormalised on purpose: it means every query can filter on one column
/// instead of joining its way back to a root, and it is what makes a
/// row-level-security policy expressible on each table rather than only on a
/// few. The foreign key on each child keeps it honest.
///
/// Session is the one table with no orgId, because a session is how the
/// application FINDS OUT which organisation a request belongs to. It cannot
/// be filtered by the answer it is being asked for.
model Organisation {
  id String @id @default(cuid())

  /// URL-safe workspace identifier, e.g. "hicon". People sign in under it, so
  /// the same email address can be a different account in a different
  /// organisation without the two ever being confused.
  slug String @unique
  name String

  // -- the letterhead ------------------------------------------------------
  //
  // This used to be seven environment variables read by lib/company.ts, which
  // could only ever describe one company. A quotation is a document the
  // customer acts on, so every field a customer reads has to belong to the
  // organisation that sent it.
  legalName String?
  address   String?
  gstin     String?
  phone     String?
  email     String?
  website   String?

  /// The logo itself, not a link to one.
  ///
  /// A quotation goes to a customer and is kept. Pointing at an image host
  /// means the day that host goes down, or the file is moved, every document
  /// ever sent renders with a hole in it. Logos are a few kilobytes; the
  /// certainty is worth the column.
  logo     Bytes?
  logoMime String?

  // -- where customers pay -------------------------------------------------
  bankBeneficiary String?
  bankName        String?
  bankAccount     String?
  bankIfsc        String?
  bankAccountType String?
  bankBranch      String?

  /// Where this organisation's REF- series starts. Continuing an existing
  /// numbering from an older system is a per-organisation fact.
  quotationNumberStart Int @default(1)

  // -- what a new quotation starts out saying ------------------------------
  //
  // These were three constants compiled into server/quotations.ts, written
  // for one company: a subject naming PUF panels, and terms fixing the
  // jurisdiction to Delhi. Every company that ever signed up would have
  // inherited them. Same problem the letterhead had, and the same fix.
  //
  // They seed a new quotation and nothing more. The CRE editing that
  // quotation can change any of it, and doing so never touches these - a
  // quotation is a document that was sent, and what it said stays with it.
  quotationSubject String?
  quotationNote    String?
  quotationTerms   String?

  isActive  Boolean  @default(true)

  /// When this workspace's paid access runs out. Null means it never does -
  /// the seed script and a platform administrator creating a workspace by
  /// hand both leave it unset. A self-service signup gets a 14-day trial
  /// here, and a platform administrator extends it manually once the
  /// customer pays; enforcement treats an expired date exactly like
  /// isActive=false; both are checked wherever the other is.
  subscriptionUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  leads      Lead[]
  activities LeadActivity[]
  companies  Company[]
  contacts   Contact[]
  orders     Order[]
  payments   Payment[]
  quotations Quotation[]
  revisions  QuotationRevision[]
  items      QuotationItem[]
  creLinks   CreSalesman[]
  syncStates SyncState[]
  auditEvents AuditEvent[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Unique within the organisation, not across the platform. One person can
  /// hold an account in two organisations - an owner running a manufacturing
  /// company and a trading company is an ordinary thing in this market - and
  /// the two are separate accounts with their own role and their own password.
  email        String
  passwordHash String
  name         String
  phone        String?
  role         Role
  isActive     Boolean @default(true)

  /// The salesmen this CRE works for. Empty for every other role.
  ///
  /// Many-to-many, because one CRE can serve more than one salesman. Which of
  /// them a CRE is acting for at any moment is a per-session choice, not a
  /// property of the account - see lib/session.ts.
  salesmen CreSalesman[] @relation("CreSalesmanCre")

  /// The CREs assigned to this salesman.
  cres CreSalesman[] @relation("CreSalesmanSalesman")

  createdById  String?
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers User[] @relation("UserCreatedBy")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  sessions         Session[]
  ownedLeads       Lead[]         @relation("LeadOwner")
  creLeads         Lead[]         @relation("LeadCre")
  salesOrders      Order[]        @relation("OrderSalesman")
  creOrders        Order[]        @relation("OrderCre")
  recordedPayments Payment[]      @relation("PaymentRecordedBy")
  activities       LeadActivity[] @relation("ActivityActor")
  auditEvents      AuditEvent[]   @relation("AuditActor")
  quotations       Quotation[]         @relation("QuotationCre")
  salesQuotations  Quotation[]         @relation("QuotationSalesman")
  revisions        QuotationRevision[] @relation("RevisionActor")
  clientCompanies  Company[]      @relation("CompanySalesman")

  @@unique([orgId, email])
  @@index([orgId])
  @@index([role])
}

/// Which salesmen a CRE works for.
///
/// Replaces the old `User.managerId`, which could only hold one. A CRE with
/// two or more rows here picks the one they are acting for from the sidebar,
/// and that choice decides which leads they see and which salesman a new
/// quotation is credited to.
model CreSalesman {
  id String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)


  creId String
  cre   User   @relation("CreSalesmanCre", fields: [creId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Restrict, because a salesman holding CREs must never vanish silently:
  /// deleteUser() re-points them inside the transaction first.
  salesmanId String
  salesman   User   @relation("CreSalesmanSalesman", fields: [salesmanId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@unique([creId, salesmanId])
  @@index([creId])
  @@index([salesmanId])
}

model Session {
  id String @id @default(cuid())

  /// sha256 of the opaque cookie token. The raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  /// Set when a platform administrator opened this workspace to support it.
  ///
  /// The session is otherwise completely ordinary - same scope clauses, same
  /// permissions, same organisation. That is the point: support happens
  /// INSIDE a tenant rather than through a hole in the boundary, so a bug in
  /// the CRM can never widen it. The banner on screen and the audit row come
  /// from this column.
  impersonatedById String?
  impersonatedBy   PlatformAdmin? @relation(fields: [impersonatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([impersonatedById])
}

// ---------------------------------------------------------------------------
// The platform
// ---------------------------------------------------------------------------

/// Whoever runs this software, as opposed to whoever uses it.
///
/// Deliberately NOT a Role on User. A User belongs to exactly one
/// organisation and every query about one is filtered by that, with no branch
/// anywhere that can turn the filter off - which is the only reason the
/// isolation is worth believing. Adding a role that skips it would put that
/// hole back, and every query written afterwards would depend on nobody
/// reaching it by accident.
///
/// So this is a separate identity with a separate session, and it reaches
/// customer data by two explicit routes only: the platform console, whose
/// queries say out loud that they read across organisations, and
/// impersonation, which issues an ordinary scoped session inside one tenant.
model PlatformAdmin {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  isActive     Boolean @default(true)

  /// Seeded accounts start with a password from the environment, which by
  /// then has been in a shell history and a config file. This forces it to be
  /// replaced before the account can do anything.
  mustChangePassword Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions       PlatformSession[]
  impersonations Session[]
}

/// A platform administrator's own sign-in, kept apart from Session.
///
/// Separate table rather than a nullable column on Session, so that no code
/// path reading a CRM session can ever be handed a platform one by mistake.
model PlatformSession {
  id String @id @default(cuid())

  tokenHash String        @unique
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  userAgent String?
  ip        String?

  @@index([adminId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id     String     @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  source LeadSource
  status LeadStatus @default(NEW)

  /// A lead can arrive with nothing but a name and a phone number, so
  /// everything except personName is optional.
  personName  String
  phone       String?
  email       String?
  companyName String?
  city        String?
  state       String?
  product     String?
  message     String?

  /// Normalised dedupe keys: digits-only phone, lowercased email.
  /// Unique and NULL-tolerant. Postgres treats each NULL as distinct, so
  /// leads with no phone or no email never collide with each other.
  ///
  /// Scoped to the organisation, NOT globally unique. A plain @unique here
  /// would mean one company capturing a lead permanently blocked every other
  /// company from ever capturing the same person - and the failure would be
  /// silent: the customer simply never appears.
  phoneKey String?
  emailKey String?

  /// Provider-side id (IndiaMART QUERY_ID, Meta leadgen_id) for idempotent ingest.
  externalId String?

  /// Null owner == sitting in the pool, grabbable by any salesman.
  /// SetNull rather than Cascade: deleting a user must never delete a lead.
  ownerId   String?
  owner     User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  grabbedAt DateTime?

  /// The CRE the salesman handed this lead to, who quotes it and places the
  /// order. Separate from ownerId on purpose: the salesman stays the owner, so
  /// the Overview keeps crediting their grabs and the delete-and-transfer
  /// rules keep working unchanged.
  creId        String?
  cre          User?     @relation("LeadCre", fields: [creId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  handedToCreAt DateTime?

  nextFollowUpAt DateTime?
  lostReason     String?

  /// When the lead arrived at the source, not when we stored it.
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order      Order?
  activities LeadActivity[]
  quotations Quotation[]

  @@unique([orgId, phoneKey])
  @@unique([orgId, emailKey])
  @@unique([orgId, source, externalId])
  @@index([orgId])
  @@index([creId])
  @@index([ownerId])
  @@index([status])
  @@index([source])
  @@index([receivedAt])
  @@index([ownerId, receivedAt])
  // The CRE "my leads" list (scope.ts leadsWhereUnscoped ASSIGNED) filters on
  // both together - a CRE serving several salesmen narrows creId's leads down
  // to whichever salesman's book they are currently acting for.
  @@index([creId, ownerId])
  // "Leads grabbed this month" on the Overview filters ownerId with a date
  // range; without this it degrades with a salesman's whole lead history
  // instead of just the reporting month.
  @@index([ownerId, grabbedAt])
}

model LeadActivity {
  id     String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  kind    ActivityKind
  message String

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Company {
  id    String  @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  name  String
  city  String?
  state String?
  gstin String?

  /// The salesman this client belongs to. A CRE only quotes the clients of
  /// the salesman they report to; admins and the owner see all of them.
  /// Null means unassigned, which is what an unmatched import leaves behind.
  salesmanId String?
  salesman   User?   @relation("CompanySalesman", fields: [salesmanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  orders     Order[]
  quotations Quotation[]

  @@index([orgId])
  @@index([name])
  @@index([salesmanId])
}

model Contact {
  id        String  @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  phone       String?
  email       String?
  designation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  quotations Quotation[]

  @@index([orgId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Orders and money
// ---------------------------------------------------------------------------

model Order {
  id String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)


  /// Human-readable running number, e.g. ORD-2026-0007. Every organisation
  /// counts from one; the series belongs to them, not to the platform.
  orderNo String

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The accepted quotation this order was placed from. Null only for orders
  /// an admin raised directly without quoting.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Never null: an order always belongs to a salesman. On delete the
  /// transaction re-points it before the user row goes.
  salesmanId String
  salesman   User   @relation("OrderSalesman", fields: [salesmanId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  creId        String?
  cre          User?     @relation("OrderCre", fields: [creId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  handedOverAt DateTime?

  /// INR in integer paise. BigInt, so a crore-plus order cannot overflow.
  amountPaise BigInt

  stage OrderStage @default(CONFIRMED)
  title String?
  notes String?

  confirmedAt DateTime  @default(now())
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@unique([orgId, orderNo])
  @@index([orgId])
  @@index([salesmanId])
  @@index([creId])
  @@index([stage])
  @@index([confirmedAt])
  // "Orders closed this month" on the Overview filters creId with a date
  // range; without this it degrades with a CRE's whole order history instead
  // of just the reporting month.
  @@index([creId, closedAt])
  // The salesman's own orders list (scope.ts ordersWhereUnscoped TEAM), which
  // also feeds the Overview - filters orgId and salesmanId together on every
  // load.
  @@index([orgId, salesmanId])
}

model Payment {
  id      String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// INR in integer paise. Always positive.
  amountPaise BigInt
  mode        PaymentMode @default(BANK_TRANSFER)
  reference   String?
  note        String?

  receivedAt DateTime @default(now())

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([orderId])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------

/// What the customer is sent before an order exists.
///
/// A CRE builds one of these on a spreadsheet-style grid, every line typed by
/// hand. Accepting it is what creates the Order, and the payable amount on the
/// quotation becomes the order value.
///
/// Party details are SNAPSHOT here rather than only referenced. A quotation is
/// a document that was sent on a date; if the customer later changes their
/// address or GST number, the quotation that went out must not silently
/// change with it.
model Quotation {
  id String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)


  /// Human-readable running number, e.g. REF-020. Continues the series the
  /// old Apps Script system was using.
  quoteNo String
  status  QuotationStatus @default(DRAFT)

  /// Null for a walk-in quoted without a lead behind it.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The CRE who built it. Restrict, so deleteUser() has to re-point it first.
  ///
  /// Kept for the audit trail and for scoping, but deliberately NOT printed on
  /// the document: the customer sees the salesman who owns the relationship.
  creId String
  cre   User   @relation("QuotationCre", fields: [creId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// The salesman this quotation is raised for, and whose name, phone and
  /// email appear on the PDF.
  ///
  /// Written once when the quotation is created: the lead owner if there is a
  /// lead, otherwise the salesman the CRE was acting for. It has to be stored
  /// rather than derived, because a CRE serving two salesmen gives no single
  /// answer to "whose is this?", and because the order placed from it takes
  /// its salesman from here.
  salesmanId String?
  salesman   User?   @relation("QuotationSalesman", fields: [salesmanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // -- party snapshot ------------------------------------------------------
  partyName      String
  contactPerson  String?
  customerMobile String?
  customerEmail  String?
  customerGst    String?

  billingStreet   String?
  billingCity     String?
  billingState    String?
  billingPincode  String?
  billingCountry  String? @default("India")

  shippingPartyName     String?
  shippingContactPerson String?
  shippingStreet        String?
  shippingCity          String?
  shippingState         String?
  shippingPincode       String?
  shippingCountry       String? @default("India")

  // -- document text (editable, seeded from a template) --------------------
  subject String?
  note    String?
  terms   String?

  // -- money, all INR in integer paise -------------------------------------
  /// Sum of the line items. Recomputed from items on every write.
  subTotalPaise BigInt @default(0)
  freightPaise  BigInt @default(0)
  /// Whole percent, 18 by default.
  gstPercent    Int    @default(18)
  gstPaise      BigInt @default(0)
  /// subTotal + freight + gst. This is what the order is placed for.
  payablePaise  BigInt @default(0)

  /// Highest revision number issued so far. 1 means never reworked.
  revisionCount Int @default(0)

  validUntil DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     QuotationItem[]
  revisions QuotationRevision[]
  order     Order?

  @@unique([orgId, quoteNo])
  @@index([orgId])
  @@index([creId])
  @@index([salesmanId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  // The salesman's own quotations list (scope.ts quotationsWhereUnscoped
  // TEAM), which also feeds the Overview - filters orgId and salesmanId
  // together on every load.
  @@index([orgId, salesmanId])
}

/// One saved state of a quotation, kept so a rework can be traced.
///
/// A quotation is a document that gets negotiated: the rate moves, a line is
/// added, freight appears. "What did we send them last time and what changed
/// since?" is a question people actually need answered, and reconstructing it
/// from an audit log of individual field writes is guesswork. So each save
/// stores the whole document plus a written summary of what moved.
model QuotationRevision {
  id          String    @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// 1 for the first save, then 2, 3, ... Revision 1 is the original; anything
  /// above that is a rework.
  revision Int

  actorId String?
  actor   User?   @relation("RevisionActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// The full document as it stood, so any two revisions can be compared
  /// later even for fields nobody thought to diff at the time.
  snapshot Json

  /// What changed against the previous revision, in plain sentences. Empty on
  /// revision 1, which had nothing to change against.
  summary String

  itemCount     Int
  subTotalPaise BigInt
  payablePaise  BigInt

  createdAt DateTime @default(now())

  @@index([orgId])
  @@unique([quotationId, revision])
  @@index([quotationId, createdAt])
}

/// One row of the quotation grid. Every column is free text the CRE types,
/// which is the whole point: the old panel-picker modals are gone.
model QuotationItem {
  id          String    @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  /// 1-based row order in the grid.
  position Int

  particular     String?
  panelThickness String?
  density        String?
  specs          String?
  sheetThickness String?
  description    String?
  uom            String?

  /// The expression the quantity was worked out from, e.g. "2+2*8", exactly
  /// as it was typed into the calculator.
  ///
  /// qtyMilli is the answer; this is the working. Keeping only the answer
  /// meant that three days later "18 SQM" gave no hint of whether that was
  /// two panels plus two rows of eight or something else, and correcting it
  /// meant redoing the sum from scratch. Null when the quantity was typed as
  /// a plain number, because "18" is not working worth keeping.
  ///
  /// Internal: the customer sees the quantity, never this.
  qtyFormula  String?

  /// Quantity in thousandths, so 123.45 SQM is stored as 123450. Integer
  /// arithmetic only, exactly like the money columns: amountPaise is
  /// qtyMilli * ratePaise / 1000, rounded once.
  qtyMilli    Int    @default(0)
  ratePaise   BigInt @default(0)
  amountPaise BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@unique([quotationId, position])
  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Operational tables
// ---------------------------------------------------------------------------

/// One row per background job, e.g. "indiamart". Holds the last-run timestamp
/// that enforces the hard 5-minute rate limit, plus an in-flight lock so two
/// overlapping cron hits cannot both call the provider.
model SyncState {
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// The job name, e.g. "indiamart". Unique per organisation, because each
  /// one polls with its own credentials on its own five-minute clock.
  key           String
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lockedAt      DateTime?
  lastStatus    String?
  lastError     String?
  fetched       Int       @default(0)
  created       Int       @default(0)
  duplicates    Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@id([orgId, key])
}

/// A fixed-window counter for login brute-force protection.
///
/// Not scoped to an organisation: the key already encodes what is being
/// limited (e.g. "login:<email>:<ip>"), and rate limiting has to work before
/// any organisation is known - a login attempt against an email that does not
/// exist still has to be throttled.
///
/// Backed by the database rather than process memory because this app runs on
/// Vercel: each request can land on an independently cold-started serverless
/// instance with no shared memory, so an in-process counter would reset on
/// every new instance and never actually enforce the limit. `hit()` in
/// lib/rate-limit.ts increments this with one atomic INSERT ... ON CONFLICT,
/// so concurrent requests across instances still serialise correctly.
model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

/// Append-only trail. User deletions and work transfers write here, so there
/// is always a record of where a deleted user's leads and orders went.
model AuditEvent {
  id     String @id @default(cuid())

  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  action String
  detail String

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  targetType String?
  targetId   String?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([createdAt])
  @@index([targetType, targetId])
}
